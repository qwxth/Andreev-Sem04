CREATE FUNCTION public.reduce_stock_on_order() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Уменьшаем количество товара на складе на заказанное количество
    UPDATE products
    SET in_stock = in_stock - NEW.quantity
    WHERE product_id = NEW.product_id;
    
    -- Проверка: если стало отрицательным – откат
    IF (SELECT in_stock FROM products WHERE product_id = NEW.product_id) < 0 THEN
        RAISE EXCEPTION 'Недостаточно товара на складе (ID: %)', NEW.product_id;
    END IF;
    
    RETURN NEW;
END;
$$;


